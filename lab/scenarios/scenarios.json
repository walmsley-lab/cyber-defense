{
  "environment": "synthetic-attack-lab",
  "resources": [
    {
      "kind": "Pod",
      "metadata": {
        "name": "gateway",
        "namespace": "demo",
        "labels": {
          "app": "gateway"
        }
      },
      "spec": {
        "automountServiceAccountToken": false,
        "containers": [
          {
            "name": "gateway",
            "securityContext": {
              "privileged": false
            }
          }
        ]
      }
    },
    {
      "kind": "Pod",
      "metadata": {
        "name": "protected-db",
        "namespace": "demo",
        "labels": {
          "app": "protected-db",
          "cyber-defense/protected": "true"
        }
      },
      "spec": {
        "automountServiceAccountToken": false,
        "containers": [
          {
            "name": "db",
            "securityContext": {
              "privileged": false
            }
          }
        ]
      }
    },
    {
      "kind": "Pod",
      "metadata": {
        "name": "worker",
        "namespace": "demo",
        "labels": {
          "app": "worker"
        }
      },
      "spec": {
        "automountServiceAccountToken": true,
        "containers": [
          {
            "name": "worker",
            "securityContext": {
              "privileged": true
            }
          }
        ]
      }
    },
    {
      "kind": "Service",
      "metadata": {
        "name": "gateway-public",
        "namespace": "demo"
      },
      "spec": {
        "type": "LoadBalancer",
        "selector": {
          "app": "gateway"
        },
        "ports": [
          {
            "port": 80
          }
        ]
      }
    },
    {
      "kind": "ClusterRole",
      "metadata": {
        "name": "overpowered"
      },
      "rules": [
        {
          "apiGroups": [
            ""
          ],
          "resources": [
            "secrets"
          ],
          "verbs": [
            "*"
          ]
        }
      ]
    }
  ]
}
